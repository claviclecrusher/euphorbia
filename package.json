{
  "name": "euphorbia",
  "productName": "Euphorbia",
  "version": "0.21.4",
  "description": "Euphorbia: an unofficial desktop client for Overleaf servers (self-hosted Community Edition or overleaf.com)",
  "homepage": "https://github.com/claviclecrusher/euphorbia",
  "main": "src/main.js",
  "license": "AGPL-3.0-only",
  "author": "Euphorbia contributors",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "release": "bash scripts/release.sh"
  },
  "build": {
    "appId": "local.overleaf.desktop",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Euphorbia contributors",
      "executableName": "euphorbia",
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "euphorbia-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "claviclecrusher",
        "repo": "euphorbia"
      }
    ],
    "appImage": {
      "artifactName": "euphorbia-${version}.${ext}"
    },
    "portable": {
      "artifactName": "euphorbia-portable-${version}.${ext}"
    },
    "deb": {
      "artifactName": "euphorbia_${version}_amd64.${ext}"
    },
    "icon": "build/icon.png"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "electron-updater": "^6.3.9",
    "fflate": "^0.8.3",
    "openai": "^7.62.0"
  }
}
