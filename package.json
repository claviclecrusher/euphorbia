{
  "name": "overleaf-desktop",
  "productName": "Overleaf Desktop",
  "version": "0.11.0",
  "description": "Desktop client for a self-hosted Overleaf Community Edition server",
  "homepage": "https://github.com/claviclecrusher/overleaf-desktop",
  "main": "src/main.js",
  "license": "MIT",
  "author": "overleaf-desktop",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "release": "bash scripts/release.sh"
  },
  "build": {
    "appId": "local.overleaf.desktop",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "overleaf-desktop"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "overleaf-desktop-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "claviclecrusher",
        "repo": "overleaf-desktop"
      }
    ],
    "appImage": {
      "artifactName": "overleaf-desktop-${version}.${ext}"
    },
    "portable": {
      "artifactName": "overleaf-desktop-portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "electron-updater": "^6.3.9",
    "fflate": "^0.8.3",
    "openai": "^7.62.0"
  }
}
